{
  "name": "roadtest-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-subtitles.mjs && node --experimental-strip-types scripts/prepare-events.mjs && vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "prepare:media": "node scripts/prepare-media.mjs",
    "import:ocr": "node scripts/import-ocr.mjs",
    "import:asr": "node scripts/import-asr.mjs",
    "prepare:subtitles": "node scripts/prepare-subtitles.mjs",
    "prepare:events": "node --experimental-strip-types scripts/prepare-events.mjs",
    "calibrate:media": "node --experimental-strip-types scripts/calibrate-media.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
