      "reviewStatus": "unreviewed"
    },
    {
      "id": "90",
      "startMs": 250083,
      "endMs": 251650,
      "rawText": "前方路口直行",
      "correctedText": null,
      "reviewStatus": "unreviewed"
    },
    {
      "id": "91",
      "startMs": 252083,
      "endMs": 253400,
      "rawText": "听到直行口令后",
