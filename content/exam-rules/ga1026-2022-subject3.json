      "id": "GA1026-2022-6.3.2.1.1-b",
      "clause": "6.3.2.1.1-b",
      "scope": "general",
      "section": "不合格情形",
      "text": "遮挡、关闭车内音视频监控设备的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-c",
      "clause": "6.3.2.1.1-c",
      "scope": "general",
      "section": "不合格情形",
      "text": "不按考试员指令驾驶的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-d",
      "clause": "6.3.2.1.1-d",
      "scope": "general",
      "section": "不合格情形",
      "text": "不能正确使用灯光、雨刮器等车辆常用操纵件的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-e",
      "clause": "6.3.2.1.1-e",
      "scope": "general",
      "section": "不合格情形",
