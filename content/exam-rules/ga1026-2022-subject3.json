      "clause": "6.3.2.1.1-i",
      "scope": "general",
      "section": "不合格情形",
      "text": "行驶中，连续使用起步挡行驶距离超过 50m 的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-j",
      "clause": "6.3.2.1.1-j",
      "scope": "general",
      "section": "不合格情形",
      "text": "单手控制转向盘时，不能有效、平稳控制行驶方向的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-k",
      "clause": "6.3.2.1.1-k",
      "scope": "general",
      "section": "不合格情形",
      "text": "车辆行驶方向控制不准确，方向晃动，车辆偏离正确行驶方向的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-l",
      "clause": "6.3.2.1.1-l",
      "scope": "general",
      "section": "不合格情形",
      "text": "不能根据交通情况合理选择行驶车道、速度的；",
      "penalty": "fail"
    },
