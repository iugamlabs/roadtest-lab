      "clause": "6.3.2.1.1-o",
      "scope": "general",
      "section": "不合格情形",
      "text": "行驶中，空挡滑行的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-p",
      "clause": "6.3.2.1.1-p",
      "scope": "general",
      "section": "不合格情形",
      "text": "行驶中，视线离开行驶方向超过 2s 的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-q",
      "clause": "6.3.2.1.1-q",
      "scope": "general",
      "section": "不合格情形",
      "text": "违反交通安全法律、法规，影响交通安全的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-r",
      "clause": "6.3.2.1.1-r",
      "scope": "general",
      "section": "不合格情形",
      "text": "不按交通信号灯、标志、标线或者交通警察指挥信号行驶的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-s",
      "clause": "6.3.2.1.1-s",
      "scope": "general",
      "section": "不合格情形",
      "text": "不按规定速度行驶的；",
      "penalty": "fail"
    },
    {
      "id": "GA1026-2022-6.3.2.1.1-t",
      "clause": "6.3.2.1.1-t",
